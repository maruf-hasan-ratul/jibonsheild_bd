<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only necessary permission for offline/online network detection -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_shield_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_shield_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.JibonShieldBD">

        <!-- Splash Launcher Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.JibonShieldBD.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Emergency Dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.JibonShieldBD" />

    </application>

</manifest>
