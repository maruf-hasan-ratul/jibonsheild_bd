<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jibonshield.bd">

    <!-- Essential permissions for network verification, cloud synchronization, and notifications -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".JibonShieldApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_shield_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_shield_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.JibonShieldBD">

        <!-- Splash Launcher Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.JibonShieldBD.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1. Main Emergency Dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 2. Flood Warning List -->
        <activity
            android:name=".activities.FloodWarningListActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 3. Flood Warning Details -->
        <activity
            android:name=".activities.FloodWarningDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 4. Shelter Directory -->
        <activity
            android:name=".activities.ShelterDirectoryActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 5. Shelter Details -->
        <activity
            android:name=".activities.ShelterDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 6. Emergency Contacts -->
        <activity
            android:name=".activities.EmergencyContactsActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 7. Water Observation Form -->
        <activity
            android:name=".activities.WaterObservationFormActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 8. Water Observation History -->
        <activity
            android:name=".activities.WaterObservationHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 9. Heat Safety -->
        <activity
            android:name=".activities.HeatSafetyActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 10. Evacuation Guidelines -->
        <activity
            android:name=".activities.EvacuationGuidelinesActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 11. Preparedness Checklist -->
        <activity
            android:name=".activities.PreparednessChecklistActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 12. Settings -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- 13. About & Data Sources -->
        <activity
            android:name=".activities.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- Authentication & Profile Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.JibonShieldBD" />

        <!-- Persistent Emergency Monitoring Foreground Service -->
        <service
            android:name=".services.EmergencyMonitoringService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
