<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_evacuation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_evacuation"
        style="@style/Widget.JibonShieldBD.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_evacuation_guidelines"
        app:subtitle="@string/subtitle_evacuation_guidelines" />

    <!-- Disaster Type Tabs / Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_small"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_disasters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_flood_prep"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tab_evac_flood_prep" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_flood_evac"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_evac_flood_evac" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_cyclone"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_evac_cyclone" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_rain_waterlog"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_evac_rain_waterlog" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_family_comm"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_evac_family_comm" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_docs"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_evac_docs" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_supplies"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_evac_supplies" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_earthquake"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_disaster_earthquake" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster_fire"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_disaster_fire" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <!-- Stages Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Educational Disclaimer Banner -->
            <TextView
                android:id="@+id/tv_evac_disclaimer_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:background="@drawable/bg_status_banner"
                android:drawableStart="@drawable/ic_shield_logo"
                android:drawablePadding="@dimen/spacing_small"
                android:lineSpacingExtra="2dp"
                android:padding="@dimen/spacing_medium"
                android:text="@string/evac_disclaimer_banner"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <!-- Stage 1: Before -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/tv_stage_before_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stage_before"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_stage_before_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/evac_flood_before"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 2: During -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:strokeColor="@color/emergency_red">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/tv_stage_during_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stage_during"
                        android:textColor="@color/emergency_red"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_stage_during_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/evac_flood_during"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 3: After -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:strokeColor="@color/secondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/tv_stage_after_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stage_after"
                        android:textColor="@color/secondary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_stage_after_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/evac_flood_after"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xlarge" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
