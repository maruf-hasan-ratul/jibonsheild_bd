<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_flood_warning_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_flood_warnings"
        style="@style/Widget.JibonShieldBD.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_flood_warnings"
        app:subtitle="@string/subtitle_flood_warnings" />

    <!-- Region Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_small">

        <ImageView
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:contentDescription="@string/cd_filter_icon"
            android:src="@drawable/ic_filter" />

        <TextView
            android:id="@+id/tv_flood_filter_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:text="@string/label_warning_region"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_flood_region"
            android:layout_width="0dp"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <!-- Content Area: Loading, Empty State, or List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progress_flood_warnings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <include
            android:id="@+id/empty_state_flood"
            layout="@layout/layout_empty_state" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_flood_warnings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_xlarge"
            tools:listitem="@layout/item_flood_warning" />

    </FrameLayout>

</LinearLayout>
