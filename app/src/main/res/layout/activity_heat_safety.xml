<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_heat_safety_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_heat_safety"
        style="@style/Widget.JibonShieldBD.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_heat_safety"
        app:subtitle="@string/subtitle_heat_safety" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Extreme Heat Alert Banner -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/warning_amber_light"
                app:strokeColor="@color/warning_amber">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_alert_banner_title"
                        android:textColor="@color/warning_amber"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/heat_alert_banner_desc"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1: Prevention & Hydration -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_section_prevention_title"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_prevention_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Symptoms -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_section_symptoms_title"
                        android:textColor="@color/secondary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_symptoms_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Urgent First Aid Actions -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:strokeColor="@color/emergency_red">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_section_urgent_help_title"
                        android:textColor="@color/emergency_red"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_urgent_help_body"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_heat_call_16263"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:backgroundTint="@color/emergency_red"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/btn_call_health_line"
                        android:textColor="@color/surface_white"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_call_emergency"
                        app:iconGravity="textStart"
                        app:iconTint="@color/surface_white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xlarge" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
