<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_heat_safety_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_heat_safety"
        style="@style/Widget.JibonShieldBD.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_heat_safety"
        app:subtitle="@string/subtitle_heat_safety" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Banner: Extreme Heat Protocol & Offline Status -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/warning_amber_light"
                app:strokeColor="@color/warning_amber">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_alert_banner_title"
                        android:textColor="@color/warning_amber"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/heat_alert_banner_desc"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1: Preparing for Hot Weather -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_prep_title"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_prep_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Hydration & Rest Guidance -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_hydration_title"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_hydration_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Reducing Heat Exposure -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_exposure_title"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_exposure_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Advice for Outdoor Workers -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_workers_title"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_workers_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 5: Precautions for Children, Older Adults & Vulnerable -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_vulnerable_title"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_vulnerable_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 6: Recognizing Heat-Related Illness -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_illness_types_title"
                        android:textColor="@color/secondary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_illness_types_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 7: Urgent Response Guidance for Suspected Heatstroke -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:strokeColor="@color/emergency_red">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_urgent_title"
                        android:textColor="@color/emergency_red"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_urgent_body"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 8: When to Seek Medical Assistance -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_medical_title"
                        android:textColor="@color/secondary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/heat_medical_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medical Disclaimer -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heat_disclaimer_title"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/heat_disclaimer_body"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Emergency Helplines Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_heat_call_16263"
                style="@style/Widget.JibonShieldBD.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/btn_call_health_line"
                app:icon="@drawable/ic_call_emergency" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_heat_call_999"
                style="@style/Widget.JibonShieldBD.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/btn_heat_call_999"
                app:icon="@drawable/ic_call_emergency" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_heat_call_1090"
                style="@style/Widget.JibonShieldBD.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_xlarge"
                android:text="@string/btn_heat_call_1090"
                app:icon="@drawable/ic_call_emergency" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
