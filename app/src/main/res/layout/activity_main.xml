<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Top App Bar with Branding -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_main"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/cd_app_logo"
                    android:src="@drawable/ic_shield_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/surface_white"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_location_label"
                        android:textColor="#CCFFFFFF"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Scroll Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xlarge">

            <!-- Offline Mode Status Banner -->
            <LinearLayout
                android:id="@+id/banner_offline_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_small"
                android:background="@drawable/bg_status_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_medium">

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:contentDescription="@string/cd_offline_icon"
                    android:src="@drawable/ic_offline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_offline_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_offline_mode"
                        android:textColor="@color/badge_offline_text"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_offline_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_offline_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- National Emergency Hotlines Quick Action Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_emergency_banner"
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginEnd="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_small"
                app:strokeColor="@color/emergency_red">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:contentDescription="@string/cd_hotline_icon"
                            android:src="@drawable/ic_call_emergency" />

                        <TextView
                            android:id="@+id/tv_hotline_banner_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_medium"
                            android:text="@string/emergency_hotline_title"
                            android:textColor="@color/emergency_red"
                            android:textSize="@dimen/text_size_subhead"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_hotline_banner_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:text="@string/emergency_hotline_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_small" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_emergency_hotlines"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:backgroundTint="@color/emergency_red"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/btn_quick_call"
                        android:textColor="@color/surface_white"
                        android:textSize="@dimen/text_size_body"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_call_emergency"
                        app:iconGravity="textStart"
                        app:iconTint="@color/surface_white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dashboard Module Section Header -->
            <TextView
                android:id="@+id/tv_modules_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_xsmall"
                android:text="@string/dashboard_greeting"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subhead"
                android:textStyle="bold" />

            <!-- Dashboard Modules RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_dashboard_modules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:itemCount="8"
                tools:listitem="@layout/item_dashboard_card" />

            <!-- Baseline Data Stamp Footer -->
            <TextView
                android:id="@+id/tv_data_baseline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_large"
                android:gravity="center"
                android:text="@string/status_last_updated"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
