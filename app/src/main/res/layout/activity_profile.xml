<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_profile"
        style="@style/Widget.JibonShieldBD.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_profile" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Profile Info Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <!-- Header Row with Name and Edit Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="@dimen/spacing_medium"
                            android:contentDescription="@string/label_profile_name"
                            android:src="@drawable/ic_person"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_profile_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_title"
                                android:textStyle="bold"
                                tools:text="Md. Rahim Uddin" />

                            <TextView
                                android:id="@+id/tv_profile_role"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_badge_outline"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_caption"
                                android:textStyle="bold"
                                tools:text="Emergency Response Volunteer" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_name"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/btn_edit_name"
                            app:icon="@drawable/ic_edit"
                            app:iconTint="@color/primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:background="@color/divider_color" />

                    <!-- Full Name Details Row -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_profile_name"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption" />

                    <TextView
                        android:id="@+id/tv_profile_name_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="Md. Rahim Uddin" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_profile_email"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption" />

                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body"
                        tools:text="rahim@example.com" />

                    <TextView
                        android:id="@+id/tv_profile_email_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:visibility="gone"
                        tools:text="@string/profile_guest_email_hint" />

                    <!-- District / Hometown -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_profile_location"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption" />

                    <TextView
                        android:id="@+id/tv_profile_district"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body"
                        tools:text="Sylhet" />

                    <!-- Mode Badge -->
                    <TextView
                        android:id="@+id/tv_profile_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textColor="@color/success_green"
                        android:textSize="@dimen/text_size_caption"
                        tools:text="Authenticated Cloud Account" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Change User Name Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change_name"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/btn_edit_name"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart" />

            <!-- Logout / Sign-in Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_logout"
                style="@style/Widget.JibonShieldBD.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/btn_logout"
                android:textColor="@color/emergency_red" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
