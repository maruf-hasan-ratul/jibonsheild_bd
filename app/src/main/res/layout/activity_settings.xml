<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_settings"
        style="@style/Widget.JibonShieldBD.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_settings"
        app:subtitle="@string/subtitle_settings" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Card: Language Preference -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heading_language"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/m3_type_title_medium"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_settings_language"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small">

                        <RadioButton
                            android:id="@+id/rb_lang_bangla"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/min_touch_target"
                            android:text="@string/label_lang_bangla"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/m3_type_body_medium" />

                        <RadioButton
                            android:id="@+id/rb_lang_english"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/min_touch_target"
                            android:text="@string/label_lang_english"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/m3_type_body_medium" />
                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Theme & Display Preference -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heading_theme"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/m3_type_title_medium"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_settings_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small">

                        <RadioButton
                            android:id="@+id/rb_theme_system"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/min_touch_target"
                            android:text="@string/theme_system"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/m3_type_body_medium" />

                        <RadioButton
                            android:id="@+id/rb_theme_light"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/min_touch_target"
                            android:text="@string/theme_light"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/m3_type_body_medium" />

                        <RadioButton
                            android:id="@+id/rb_theme_dark"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/min_touch_target"
                            android:text="@string/theme_dark"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/m3_type_body_medium" />

                        <RadioButton
                            android:id="@+id/rb_theme_amoled"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/min_touch_target"
                            android:text="@string/theme_amoled"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/m3_type_body_medium" />
                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Default Location Preference -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heading_location"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="@string/desc_location_setting"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_small" />

                    <Spinner
                        android:id="@+id/spinner_settings_district"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_small" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Offline Storage Status -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heading_storage"
                        android:textColor="@color/secondary"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_storage_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/label_storage_contacts"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_small" />

                    <TextView
                        android:id="@+id/tv_storage_shelters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="@string/label_storage_shelters"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_small" />

                    <TextView
                        android:id="@+id/tv_storage_warnings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="Flood Warnings: Seeded Baseline"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_small" />

                    <TextView
                        android:id="@+id/tv_storage_database"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="@string/label_storage_database"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_small" />

                    <TextView
                        android:id="@+id/tv_sync_pending_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="@drawable/bg_severity_warning"
                        android:padding="@dimen/spacing_small"
                        android:text="@string/sync_pending_api_desc"
                        android:textColor="@color/warning_amber"
                        android:textSize="@dimen/text_size_body_small" />

                    <ProgressBar
                        android:id="@+id/progress_sync_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_sync"
                        style="@style/Widget.JibonShieldBD.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/action_sync_now"
                        app:icon="@drawable/ic_sync"
                        app:iconGravity="textStart" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings_about"
                style="@style/Widget.JibonShieldBD.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_xlarge"
                android:text="@string/btn_about_screen"
                app:icon="@drawable/ic_info"
                app:iconGravity="textStart" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
