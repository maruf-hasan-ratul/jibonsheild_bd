<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_shelter_directory_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_shelter_directory"
        style="@style/Widget.JibonShieldBD.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_shelter_directory"
        app:subtitle="@string/subtitle_shelter_directory" />

    <!-- Search Box Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.JibonShieldBD.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium">

            <ImageView
                android:layout_width="@dimen/icon_size_medium"
                android:layout_height="@dimen/icon_size_medium"
                android:contentDescription="@string/cd_search_shelter"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/et_search_shelter"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/spacing_small"
                android:background="@null"
                android:hint="@string/hint_search_shelter"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- District Filter Spinner Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_xxsmall"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xxsmall">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_shelter_district"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_shelter_district"
            android:layout_width="0dp"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <!-- Content Area: List, Progress, or Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progress_shelters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <include
            android:id="@+id/empty_state_shelter"
            layout="@layout/layout_empty_state" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_shelters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_xlarge"
            tools:listitem="@layout/item_shelter" />

    </FrameLayout>

</LinearLayout>
