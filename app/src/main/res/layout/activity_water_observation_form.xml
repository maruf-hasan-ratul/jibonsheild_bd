<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_obs_form_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_obs_form"
        style="@style/Widget.JibonShieldBD.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_water_observation_form" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Card: Basic Identification -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_obs_date"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_obs_form_date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold"
                            tools:text="2026-10-18 14:00 BST" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_change_datetime"
                            style="@style/Widget.JibonShieldBD.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/min_touch_target"
                            android:text="@string/btn_change_datetime"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_obs_date_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/emergency_red"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:background="@color/divider_color" />

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_obs_location"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_obs_location"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:background="@drawable/bg_badge"
                        android:hint="@string/hint_obs_location"
                        android:importantForAccessibility="yes"
                        android:inputType="textCapWords"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tv_obs_location_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/emergency_red"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <!-- District -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/label_obs_district"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_obs_district"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall" />

                    <!-- Water Source Type -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/label_obs_source_type"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_obs_source_type"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Quality Indicators -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <!-- Appearance -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_obs_appearance"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_obs_appearance"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall" />

                    <!-- Odor -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/label_obs_odor"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_obs_odor"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall" />

                    <!-- Optional pH -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/label_obs_ph"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_obs_ph"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:background="@drawable/bg_badge"
                        android:hint="@string/hint_obs_ph"
                        android:importantForAccessibility="yes"
                        android:inputType="numberDecimal"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tv_obs_ph_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/emergency_red"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <!-- Turbidity -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/label_obs_turbidity"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_obs_turbidity"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall" />

                    <!-- Observer Field Assessment -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/label_obs_safety"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_obs_safety"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Observer & Field Notes -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_obs_reporter"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_obs_reporter"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:background="@drawable/bg_badge"
                        android:hint="@string/hint_obs_reporter"
                        android:importantForAccessibility="yes"
                        android:inputType="textPersonName"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/label_obs_notes"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_obs_notes"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:background="@drawable/bg_badge"
                        android:gravity="top|start"
                        android:hint="@string/hint_obs_notes"
                        android:importantForAccessibility="yes"
                        android:inputType="textMultiLine"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="@dimen/text_size_body_small" />

                    <TextView
                        android:id="@+id/tv_obs_notes_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/emergency_red"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Water Safety Integrity & Educational Guidance (Requirement 3) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.JibonShieldBD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:cardBackgroundColor="@color/warning_amber_light"
                app:strokeColor="@color/warning_amber">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/obs_disclaimer_title"
                        android:textColor="@color/warning_amber"
                        android:textSize="@dimen/text_size_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/obs_disclaimer_body"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body_small" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:background="@color/divider_color" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/obs_safe_water_guidance_title"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/obs_safe_water_guidance_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_observation"
                style="@style/Widget.JibonShieldBD.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/btn_submit_observation" />

            <!-- View History Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_goto_history"
                style="@style/Widget.JibonShieldBD.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_xlarge"
                android:text="@string/btn_view_obs_history" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
