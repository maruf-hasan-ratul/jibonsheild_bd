<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_checklist_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_16"
    android:paddingTop="@dimen/spacing_8"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingBottom="@dimen/spacing_8">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_checklist_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="?attr/colorPrimary"
        android:contentDescription="@string/title_preparedness_checklist"
        android:minWidth="@dimen/touch_target_min"
        android:minHeight="@dimen/touch_target_min" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_checklist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/app_font_family"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/m3_type_body_large"
            tools:text="Drinking water (minimum 3 liters per person for 3 days)" />

        <TextView
            android:id="@+id/tv_checklist_essential"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:background="@drawable/bg_severity_warning"
            android:drawableStart="@drawable/ic_warning"
            android:drawablePadding="@dimen/spacing_4"
            android:fontFamily="@font/app_font_family"
            android:gravity="center_vertical"
            android:text="@string/tag_essential"
            android:textColor="@color/severity_warning"
            android:textSize="@dimen/m3_type_label_small"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
