<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_checklist_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/min_touch_target"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_large"
    android:paddingTop="@dimen/spacing_small"
    android:paddingEnd="@dimen/spacing_large"
    android:paddingBottom="@dimen/spacing_small">

    <CheckBox
        android:id="@+id/cb_checklist_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/primary"
        android:minWidth="@dimen/min_touch_target"
        android:minHeight="@dimen/min_touch_target" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_checklist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            tools:text="Drinking water (minimum 3 liters per person for 3 days)" />

        <TextView
            android:id="@+id/tv_checklist_essential"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_severity_warning"
            android:text="@string/tag_essential"
            android:textColor="@color/severity_warning"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
