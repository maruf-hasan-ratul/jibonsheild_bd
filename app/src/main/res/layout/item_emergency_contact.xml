<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_contact_root"
    style="@style/Widget.JibonShieldBD.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_large"
    android:layout_marginTop="@dimen/spacing_small"
    android:layout_marginEnd="@dimen/spacing_large"
    android:layout_marginBottom="@dimen/spacing_small"
    android:minHeight="@dimen/min_touch_target">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_contact_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="NATIONAL" />

            <TextView
                android:id="@+id/tv_contact_tollfree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:background="@drawable/bg_severity_safe"
                android:text="@string/label_contact_toll_free"
                android:textColor="@color/success_green"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_contact_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_size_caption"
                tools:text="24/7" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subhead"
            android:textStyle="bold"
            tools:text="National Emergency Service (Police, Fire, Ambulance)" />

        <TextView
            android:id="@+id/tv_contact_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body_small"
            tools:text="Instant police response, fire brigade dispatch, and ambulance coordination" />

        <TextView
            android:id="@+id/tv_contact_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_size_caption"
            tools:text="Source: Bangladesh Police HQ • Verified: 2026-01-01" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_contact_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/emergency_red"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                tools:text="999" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_contact_call"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/emergency_red"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/action_call"
                android:textColor="@color/surface_white"
                android:textSize="@dimen/text_size_caption"
                app:cornerRadius="6dp"
                app:icon="@drawable/ic_call_emergency"
                app:iconSize="@dimen/icon_size_small"
                app:iconTint="@color/surface_white" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
