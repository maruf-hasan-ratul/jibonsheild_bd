<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_flood_root"
    style="@style/Widget.JibonShieldBD.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginTop="@dimen/spacing_4"
    android:layout_marginEnd="@dimen/spacing_16"
    android:layout_marginBottom="@dimen/spacing_8"
    android:minHeight="@dimen/touch_target_min">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Top Row: Severity (Icon + Word + Container) & Verified/Sample Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_warning_severity_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_severity_warning"
                android:drawableStart="@drawable/ic_warning"
                android:drawablePadding="@dimen/spacing_4"
                android:fontFamily="@font/app_font_family"
                android:gravity="center_vertical"
                android:text="@string/severity_warning_label"
                android:textColor="@color/severity_warning"
                android:textSize="@dimen/m3_type_label_small"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_warning_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_severity_sample"
                android:drawableStart="@drawable/ic_info"
                android:drawablePadding="@dimen/spacing_4"
                android:fontFamily="@font/app_font_family"
                android:gravity="center_vertical"
                android:text="@string/tag_verified_alert"
                android:textColor="@color/severity_sample"
                android:textSize="@dimen/m3_type_label_small"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Warning Title -->
        <TextView
            android:id="@+id/tv_warning_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:fontFamily="@font/app_font_family"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/m3_type_title_medium"
            android:textStyle="bold"
            tools:text="Surma-Kushiyara Basin High Water Level Warning" />

        <!-- Region & Agency -->
        <TextView
            android:id="@+id/tv_warning_region"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:drawableStart="@drawable/ic_location"
            android:drawablePadding="@dimen/spacing_4"
            android:fontFamily="@font/app_font_family"
            android:gravity="center_vertical"
            android:textColor="?attr/colorSecondary"
            android:textSize="@dimen/m3_type_label_medium"
            android:textStyle="bold"
            tools:text="Region: Sylhet &amp; Sunamganj" />

        <!-- Details Snippet -->
        <TextView
            android:id="@+id/tv_warning_details_snippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:ellipsize="end"
            android:fontFamily="@font/app_font_family"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/m3_type_body_small"
            tools:text="River water levels near danger mark due to heavy rainfall in Meghalaya." />

        <!-- Footer: Issued Time -->
        <TextView
            android:id="@+id/tv_warning_issued_at"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:fontFamily="@font/app_font_family"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/m3_type_label_small"
            tools:text="Issued: 2026-10-12 08:00 BST • Source: FFWC (BWDB)" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
