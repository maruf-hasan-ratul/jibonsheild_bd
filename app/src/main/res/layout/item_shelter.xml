<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_shelter_root"
    style="@style/Widget.JibonShieldBD.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginTop="@dimen/spacing_4"
    android:layout_marginEnd="@dimen/spacing_16"
    android:layout_marginBottom="@dimen/spacing_8"
    android:minHeight="@dimen/touch_target_min">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Header: District, Upazila & Capacity Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_shelter_district_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_severity_sample"
                android:fontFamily="@font/app_font_family"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/m3_type_label_small"
                android:textStyle="bold"
                tools:text="Cox's Bazar" />

            <TextView
                android:id="@+id/tv_shelter_upazila_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:background="@drawable/bg_severity_sample"
                android:fontFamily="@font/app_font_family"
                android:textColor="?attr/colorSecondary"
                android:textSize="@dimen/m3_type_label_small"
                android:textStyle="bold"
                tools:text="Kutubdia" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Capacity Badge with Icon + Word + Container -->
            <TextView
                android:id="@+id/tv_shelter_capacity_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_severity_safe"
                android:drawableStart="@drawable/ic_shelter"
                android:drawablePadding="@dimen/spacing_4"
                android:fontFamily="@font/app_font_family"
                android:gravity="center_vertical"
                android:textColor="@color/severity_safe"
                android:textSize="@dimen/m3_type_label_small"
                android:textStyle="bold"
                tools:text="1,200 Persons" />
        </LinearLayout>

        <!-- Shelter Name -->
        <TextView
            android:id="@+id/tv_shelter_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:fontFamily="@font/app_font_family"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/m3_type_title_medium"
            android:textStyle="bold"
            tools:text="Kutubdia Model High School Cyclone Shelter" />

        <!-- Coordinates and Call Action (Accessible 48dp target) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:contentDescription="@string/label_shelter_coordinates"
                android:src="@drawable/ic_location"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_shelter_coords"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_weight="1"
                android:fontFamily="@font/app_font_family"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/m3_type_body_small"
                tools:text="21.8155° N, 91.8542° E" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_shelter_call"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/action_call"
                android:textColor="@color/severity_critical"
                android:textSize="@dimen/m3_type_label_medium"
                app:cornerRadius="@dimen/radius_12"
                app:icon="@drawable/ic_phone"
                app:iconSize="@dimen/icon_size_small"
                app:iconTint="@color/severity_critical" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
