<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_empty_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_32"
    android:visibility="gone">

    <ImageView
        android:id="@+id/iv_empty_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/cd_empty_state"
        android:src="@drawable/ic_empty_state"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:fontFamily="@font/app_font_family"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/empty_state_default_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/m3_type_title_medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:fontFamily="@font/app_font_family"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/empty_state_default_desc"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/m3_type_body_medium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_empty_action"
        style="@style/Widget.JibonShieldBD.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/spacing_16"
        android:fontFamily="@font/app_font_family"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/empty_state_default_action"
        android:visibility="gone" />

</LinearLayout>
