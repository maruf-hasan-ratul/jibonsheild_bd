rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (('admin' in request.auth.token && request.auth.token.admin == true) ||
         ('role' in request.auth.token && request.auth.token.role == 'admin'));
    }

    // 1. User Profiles: strict user boundary
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // 2. Administrative Hierarchy: Divisions
    match /divisions/{divisionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Administrative Hierarchy: Districts
    match /districts/{districtId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Administrative Hierarchy: Upazilas
    match /upazilas/{upazilaId} {
      allow read: if true;
      allow write: if false;
    }

    // 5. Emergency Shelters Directory
    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. Disaster Updates
    match /disaster_updates/{updateId} {
      allow read: if true;
      allow write: if false;
    }

    // 7. Community Water Observations
    match /water_observations/{observationId} {
      // Community water safety reports are publicly readable
      allow read: if true;
      // Anyone (authenticated citizen/volunteer or guest reporter) can submit water safety observations
      allow create: if request.resource.data.locationName is string &&
                    request.resource.data.district is string;
      // Allow updates/deletes for user or guest management
      allow update, delete: if true;
    }

    // 8. National & District Emergency Contacts
    match /emergency_contacts/{contactId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. Hydrological Flood Warnings
    match /flood_warnings/{warningId} {
      allow read: if true;
      allow write: if true;
    }

    // 10. Preparedness Checklists & Items
    match /preparedness_checklists/{checklistId} {
      allow read: if true;
      allow write: if true;
    }

    match /checklist_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // 11. Synchronization Metadata
    match /synchronization_metadata/{metaId} {
      allow read: if true;
      allow write: if true;
    }

    // 12. Official & Volunteer Disaster Reports
    match /disaster_reports/{reportId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // 13. Volunteer Emergency Reports
    match /volunteer_reports/{reportId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // 14. Historical Incident Archive
    match /incident_history/{incidentId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
